# Required for /api/inquiry delivery through the existing Sakura mailbox.
# Set real values in .env.local for local testing and in Vercel Production.
# Do not commit real API keys or local env files.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=exporter@justhen.co.jp
SMTP_PASSWORD=
SMTP_FROM=exporter@justhen.co.jp
CONTACT_NOTIFICATION_EMAIL=exporter@justhen.co.jp
# CONTACT_TO_EMAIL is accepted only as a legacy notification address fallback.
# Legacy SMTP_PASS is intentionally not used. Do not copy other-provider secrets.

# Owner authorized static public pages while inquiry remains independently off.
# Set on and redeploy to restore full-site emergency maintenance.
# Missing/invalid Production values still fail closed. Source lock remains available.
# Preview: mode off plus the following flag permits normal-site testing ONLY
# after Vercel Authentication/Deployment Protection has been verified.
MAINTENANCE_MODE=off
MAINTENANCE_PREVIEW_SITE_ENABLED=off
INQUIRY_MODE=off

# Protected Preview: default verifies SMTP authentication without delivery.
# Enable only for an explicit owner-only end-to-end trial; never on Production.
SMTP_PREVIEW_SEND=off
# The legacy INQUIRY_EMAIL_SANDBOX=on also forces Preview verification-only.
# Never place real credentials in this example or commit a local env file.

# Optional production-only analytics and site verification.
# Set real values in Vercel Production. Analytics tags do not run on localhost.
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
CLARITY_PROJECT_ID=
